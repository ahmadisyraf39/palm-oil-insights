{
  "name": "Palm Oil Insights (FHD, dark text)",
  "dataColors": [
    "#2a78b5",
    "#111827",
    "#8fb8d9",
    "#6b7280",
    "#c8d9e8",
    "#9ca3af"
  ],
  "background": "#FFFFFF",
  "foreground": "#111827",
  "tableAccent": "#2a78b5",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 18,
      "color": "#111827"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 14,
      "color": "#374151"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 38,
      "color": "#111827"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 18,
      "color": "#111827"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F4F6"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "radius": 12
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "alignment": "left",
            "fontSize": 18,
            "fontColor": {
              "solid": {
                "color": "#111827"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "gridlineThickness": 1
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false
          }
        ]
      }
    }
  }
}